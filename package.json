{
  "name": "dsh-desktop-view",
  "version": "0.1.0",
  "description": "Live view of the agent machine's desktop in the DeepSeek Harness Web UI, relayed from cua-spacesd behind DSH's own login: watch what the agent does, and take control when it needs a hand (CAPTCHAs, QR logins), also from a phone.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.js",
    "viewer/*",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "for f in index.js client.js src/*.js viewer/*.js test/*.js; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cua",
    "remote-desktop",
    "desktop-stream"
  ],
  "author": "Sakina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soffits/dsh-desktop-view.git"
  },
  "homepage": "https://github.com/soffits/dsh-desktop-view#readme",
  "bugs": {
    "url": "https://github.com/soffits/dsh-desktop-view/issues"
  }
}
